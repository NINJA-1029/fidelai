# Environment Configuration (Native Deployment)
# Copy to .env and populate with local or production values

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1

# Security and Authentication
JWT_SECRET_KEY=fidel_super_secret_jwt_key_for_development_purposes_only_32_bytes_min
SUPABASE_JWT_SECRET=fidel_super_secret_jwt_key_for_development_purposes_only_32_bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=sqlite:///./fidel.db
# For Remote Supabase / PostgreSQL:
# DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# LLM / Inference Engine (llama.cpp Native Process)
LLAMA_CPP_ENDPOINT=http://localhost:8080/completion
LLAMA_CPP_API_BASE=http://localhost:8080/v1
MODEL_NAME=Qwen2.5-Coder-32B-Instruct-GGUF
LLM_PROVIDER=mock # Options: mock, llamacpp, remote
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Frontend Configuration
FLUTTER_API_BASE_URL=http://localhost:8000/api/v1
FLUTTER_USE_MOCK_API=false
